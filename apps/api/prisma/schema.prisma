datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique
  balanceCents Int        @default(100000)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  positions    Position[]
  parlays      Parlay[]
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  symbol      String
  side        String
  quantity    Int
  fillPrice   Int
  status      String      @default("FILLED")
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  settlements Settlement?
}

model Settlement {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  result    String
  payout    Int
  settledAt DateTime @default(now())
}

model Position {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  symbol        String
  side          String
  quantity      Int
  avgPriceCents Int
  updatedAt     DateTime @updatedAt

  @@unique([userId, symbol, side])
}

model Parlay {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  status     String            @default("OPEN")
  stakeCents Int
  toWinCents Int
  parlayOdds Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  legs       ParlayLeg[]
  settlement ParlaySettlement?
}

model ParlayLeg {
  id       String @id @default(cuid())
  parlayId String
  parlay   Parlay @relation(fields: [parlayId], references: [id])
  game_id  Int
  betType  String
  side     String
  label    String
  line     Float
  odds     Int
  status   String @default("PENDING")
}

model ParlaySettlement {
  id        String   @id @default(cuid())
  parlayId  String   @unique
  parlay    Parlay   @relation(fields: [parlayId], references: [id])
  result    String
  payout    Int
  settledAt DateTime @default(now())
}
